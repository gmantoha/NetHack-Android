<?xml version="1.0" encoding="utf-8"?>
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:installLocation="auto">
	<!--
	  WRITE_EXTERNAL_STORAGE grants broad external storage access on Android 9
	  (API 28) and below.  On Android 10 (API 29) requestLegacyExternalStorage
	  (set on the application element) provides the same legacy access.  On
	  Android 11–12L (API 30-32) the permission is still declared so that the
	  system can enforce scoped-storage policies correctly.  maxSdkVersion="32"
	  prevents the permission from being requested on Android 13+ where it is
	  fully replaced by more granular media permissions.
	-->
	<uses-permission
		android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.INTERNET"/>

	<application
		android:label="NetHack"
		android:icon="@drawable/icon"
		android:largeHeap="true"
		android:theme="@android:style/Theme"
		android:allowBackup="true"
		android:requestLegacyExternalStorage="true">
		<activity
			android:name="com.tbd.forkfront.ForkFront"
			android:label="NetHack"
			android:exported="true"
			android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
			android:launchMode="singleTask"
			android:configChanges="mcc|mnc|locale|keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|fontScale">
			<!-- Prevent activity from restarting when configuration changes -->
			<intent-filter>
				<action
					android:name="android.intent.action.MAIN"/>
				<category
					android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<activity
			android:name="com.tbd.forkfront.Settings"
			android:label="NetHack Settings"
			android:exported="false">
		</activity>
	</application>
</manifest>
